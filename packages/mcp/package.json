{
  "name": "@muninn/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "muninn-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:edge": "tsup --config tsup.edge.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@muninn/assistant": "workspace:*",
    "@muninn/core": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
