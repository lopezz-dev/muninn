{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muninn",
  "version": "0.4.0",
  "identifier": "dev.lopezz.muninn",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @muninn/web dev",
    "beforeBuildCommand": "pnpm --filter @muninn/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Muninn",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co http://localhost:* ws://localhost:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "muninn"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/lopezz-dev/muninn/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzN0UwMTQ5MTAwNjM3RUQKUldUdE53WVFTUUYrWTdxdnh4b0tOSnFoZ0lFM0xWcXVYVG9ramRWcEtDMzdjM1hrS2k3SEFlNE8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Tu sistema operativo personal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
