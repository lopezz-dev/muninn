# Copia a .env.local y rellena con los datos de tu proyecto de Supabase (Settings → API Keys).
# Solo la clave pública (sb_publishable_…): todo lo que empieza por VITE_ acaba en el bundle.
# Nunca pongas aquí la service role key (sb_secret_…).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Clave pública VAPID de los avisos push (ADR-0040; la privada va solo en los secretos de la función `push`).
# Sin ella, Ajustes › Notificaciones dice que los avisos no están configurados.
VITE_VAPID_PUBLIC_KEY=
# Sin las dos de Supabase, la app arranca directamente en modo demo (datos en memoria).
