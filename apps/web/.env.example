# Copia a .env.local y rellena con los datos de tu proyecto de Supabase (Settings → API Keys).
# Solo la clave pública (sb_publishable_…): todo lo que empieza por VITE_ acaba en el bundle.
# Nunca pongas aquí la service role key (sb_secret_…).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Sin estas dos variables, la app arranca directamente en modo demo (datos en memoria).
