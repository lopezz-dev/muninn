{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @muninn/web build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/documentacion", "destination": "/es/docs", "permanent": true },
    { "source": "/documentacion/:pagina", "destination": "/es/docs/:pagina", "permanent": true }
  ],
  "rewrites": [
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/:pagina", "destination": "/docs/:pagina/index.html" },
    { "source": "/es/docs", "destination": "/es/docs/index.html" },
    { "source": "/es/docs/:pagina", "destination": "/es/docs/:pagina/index.html" },
    {
      "source": "/((?!assets/|(?:es/)?docs(?:/|$)|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sw.js|registerSW.js|push-sw.js|manifest.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
